  },

  "SyncSettings": {
    "IntervalMinutes": 60
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/sync-log.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "ApiConfig": {
    "ApiPaths": {
      "Purchase": {
        "BaseUrl": "https://localhost:7033",
        "Endpoints": {
          "ACCEPT_REJECT": "/api/purchase-invoices/accept-reject",
          "CHANGES": "/api/purchase-invoices/changes",
          "SINGLE": "/api/purchase-invoices",
          "IDS": "/api/purchase-invoices/ids",
          "XML_DOWNLOAD": "/api/purchase-invoices/xml"
        }
      },
      "PublicPurchaseContractor": {
        "BaseUrl": "https://localhost:7033",
        "Endpoints": {
          "CHANGES": "/api/public-purchase-contractor-invoices/changes",
          "SINGLE": "/api/public-purchase-contractor-invoices",
          "IDS": "/api/public-purchase-contractor-invoices/ids",
          "XML_DOWNLOAD": "/api/public-purchase-contractor-invoices/xml",
          "SIGNATURE_DOWNLOAD": "/api/public-purchase-contractor-invoices/signature"
        }
      },
      "Sales": {
        "BaseUrl": "https://localhost:7033",
        "Endpoints": {
          "CHANGES": "/api/sales-invoices/changes",
          "SINGLE": "/api/sales-invoices",
          "UBL_DOWNLOAD": "/api/sales-invoices/ubl",
          "VAT_EXEMPTIONS": "/api/sales-invoices/vat-exemptions",
          "UBL_UPLOAD": "/api/sales-invoices/ubl/upload"
        }
      }
    }
  }
}